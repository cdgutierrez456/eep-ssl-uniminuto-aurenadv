# Copia este archivo como .env y ajusta los valores. El .env nunca se versiona.

# API local de la plataforma (o del receptor de prueba)
API_URL=http://localhost:8000

# Nombre de este equipo en origen.dispositivo. Si se deja vacío, usa el nombre del equipo.
DISPOSITIVO=pc-stand

# Carpeta de la cola local de eventos y de los medios de respaldo
CARPETA_COLA=cola

# Cada cuántos segundos un módulo consulta su configuración en la plataforma
CONFIG_INTERVALO_S=3

# Nivel de los logs: DEBUG, INFO, WARNING, ERROR
LOG_NIVEL=INFO

# --- Módulo EPP (python -m modulos.epp) ---
# Índice de la cámara (recomendado) o nombre del dispositivo. Para verlas con vista previa:
# python -m herramientas.listar_camaras
# (0 suele ser la integrada del portátil; la Logitech externa del stand suele ser 1 o 2)
EPP_CAMARA=0
# Formato de captura pedido a la cámara (MJPG siempre)
EPP_CAMARA_ANCHO=1280
EPP_CAMARA_ALTO=720
EPP_CAMARA_FPS=30
# 0 = autofoco apagado y enfoque fijo en EPP_CAMARA_ENFOQUE (0 = infinito)
EPP_CAMARA_AUTOFOCO=0
EPP_CAMARA_ENFOQUE=0
# Exposición fija (en Windows suele ir de -11 a -1). Vacío = automática
EPP_CAMARA_EXPOSICION=
# 1 = abrir a pantalla completa, 0 = en ventana
EPP_PANTALLA_COMPLETA=1
# 1 = mostrar la imagen como espejo
EPP_ESPEJO=1
# Segundos que el veredicto debe mantenerse igual antes de publicar el evento
EPP_SEGUNDOS_ESTABLE=2
# Segundos sin nadie frente a la cámara para dar por terminada la visita
EPP_SEGUNDOS_SIN_PERSONA=3

# Clave de Roboflow, solo para descargar datasets (modulos/epp/datos/preparar_dataset.py)
ROBOFLOW_API_KEY=

# --- Módulo de ergonomía (python -m modulos.ergonomia, en su propio entorno) ---
# Índice de la cámara (recomendado) o nombre del dispositivo. Para verlas con vista previa:
# python -m herramientas.listar_camaras
# Conecta cada cámara siempre al mismo puerto USB: el índice cambia al cambiar de puerto.
ERGONOMIA_CAMARA=0
# Formato de captura pedido a la cámara (MJPG siempre)
ERGONOMIA_CAMARA_ANCHO=1280
ERGONOMIA_CAMARA_ALTO=720
ERGONOMIA_CAMARA_FPS=30
# 0 = autofoco apagado y enfoque fijo en ERGONOMIA_CAMARA_ENFOQUE (0 = infinito)
ERGONOMIA_CAMARA_AUTOFOCO=0
ERGONOMIA_CAMARA_ENFOQUE=0
# Exposición fija (en Windows suele ir de -11 a -1). Vacío = automática
ERGONOMIA_CAMARA_EXPOSICION=
# 1 = abrir a pantalla completa, 0 = en ventana
ERGONOMIA_PANTALLA_COMPLETA=1
# Tamaño de la pantalla del stand
ERGONOMIA_PANTALLA_ANCHO=1920
ERGONOMIA_PANTALLA_ALTO=1080
# Dispositivo del estimador de pose. Este módulo corre en CPU
ERGONOMIA_DISPOSITIVO=cpu

# URL pública del servidor de Auren, para los QR de los reportes (sin barra final).
# Con ella y un número de visitante, ergonomía muestra un QR hacia {BASE_URL_PUBLICA}/r/{sesion_id}.
# Vacía = no se muestra QR.
BASE_URL_PUBLICA=

# --- Módulo de zona de peligro (python -m modulos.zona.calibracion) ---
# Índice de la cámara alta que mira la zona (recomendado) o nombre del dispositivo.
# Para verlas con vista previa: python -m herramientas.listar_camaras
# Conecta cada cámara siempre al mismo puerto USB: el índice cambia al cambiar de puerto.
ZONA_CAMARA=0
# Formato de captura pedido a la cámara (MJPG siempre)
ZONA_CAMARA_ANCHO=1280
ZONA_CAMARA_ALTO=720
ZONA_CAMARA_FPS=30
# 0 = autofoco apagado y enfoque fijo en ZONA_CAMARA_ENFOQUE (0 = infinito)
ZONA_CAMARA_AUTOFOCO=0
ZONA_CAMARA_ENFOQUE=0
# Exposición fija (en Windows suele ir de -11 a -1). Vacío = automática.
# Con luz cambiante, fijarla ayuda a que el amarillo de la cinta se vea siempre igual.
ZONA_CAMARA_EXPOSICION=
# 1 = abrir a pantalla completa, 0 = en ventana
ZONA_PANTALLA_COMPLETA=1
# Tamaño de la pantalla del stand
ZONA_PANTALLA_ANCHO=1920
ZONA_PANTALLA_ALTO=1080
# Dónde corre la detección de personas: cpu, auto (GPU solo si nvidia-smi la muestra libre al
# arrancar; si no, CPU) o gpu. En CPU alcanza para 30 fps de cámara con una o dos personas.
ZONA_DISPOSITIVO=cpu
# Lado de la imagen que ve el detector. Más pequeño (480) es más rápido y menos preciso con gente lejos
ZONA_IMGSZ=640
# Otros pesos de pose. Vacío = modulos/zona/modelos/yolo26n-pose.pt (python -m herramientas.descargar_modelos)
ZONA_MODELO=

# --- Módulo inspector por foto ---
# Clave de la API de Claude (Anthropic). Solo vive en el .env de la PC del stand: nunca en el código,
# en los logs ni en lo que recibe el navegador. Sin ella, el inspector solo ofrece escenas preparadas.
ANTHROPIC_API_KEY=
# Modelo de visión: claude-sonnet-5-5 (rápido, por defecto) o claude-opus-5-5 (mayor calidad)
INSPECTOR_MODELO=claude-sonnet-5-5
# Cuánto razona el modelo antes de responder: low, medium o high. Más esfuerzo = más lento y más caro
INSPECTOR_ESFUERZO=medium
# Máximo de peligros por foto (se priorizan los más graves)
INSPECTOR_MAX_PELIGROS=6
# Segundos máximos de espera por un análisis, incluido un reintento
INSPECTOR_TIEMPO_MAXIMO_S=60
# Lado largo de la foto que se envía al modelo, en píxeles. 2576 = alta resolución (más detalle y más costo)
INSPECTOR_IMAGEN_LADO_MAX=1568
